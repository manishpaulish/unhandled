(library
 (name unhandled_lib)
 (wrapped false)
 ; compat_53.ml and compat_54.ml are inputs to the rules below, not modules of
 ; the library. Without this exclusion dune compiles both, and the one for the
 ; other compiler fails with "Unbound module Data_types" (or Types).
 (modules
  (:standard \ compat_53 compat_54))
 (libraries compiler-libs.common))

; Constructor descriptions moved from Types to Data_types in OCaml 5.4.
; Pick the matching shim rather than sprinkling version checks through the
; analysis code.
(rule
 (targets compat.ml)
 (deps compat_53.ml)
 (enabled_if
  (< %{ocaml_version} 5.4.0))
 (action
  (copy compat_53.ml compat.ml)))

(rule
 (targets compat.ml)
 (deps compat_54.ml)
 (enabled_if
  (>= %{ocaml_version} 5.4.0))
 (action
  (copy compat_54.ml compat.ml)))
